# ---------------------------------------------------------------------------
# Docker Compose
# COMPOSE_FILE define qual arquivo o comando abre quando nenhum -f e passado,
# entao "docker compose up" funciona sem flag em desenvolvimento. Producao passa
# "-f docker-compose.prod.yml", que sobrepoe este valor.
# ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.dev.yml
COMPOSE_PROJECT_NAME=convencendoai

# ---------------------------------------------------------------------------
# Banco de dados
# POSTGRES_PORT e o valor interno da rede do compose.
# POSTGRES_PORT_HOST e o que aparece na maquina; fora da faixa usual porque
# a maquina de desenvolvimento roda outros projetos.
# ---------------------------------------------------------------------------
POSTGRES_DB=convencendoai
POSTGRES_USER=convencendoai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5433

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5180
BACKEND_PORT=8000
# Quantos proxies reversos confiaveis ficam a frente do backend. 0 sem proxy (desenvolvimento).
# Em producao, o numero exato: o bloqueio por IP le o X-Forwarded-For a partir do fim da lista.
# Maior que o real deixa o cliente forjar o IP; menor faz todos parecerem vir do proxy.
TRUSTED_PROXY_COUNT=0
BACKEND_PORT_HOST=8010

# ---------------------------------------------------------------------------
# Chaves de API dos provedores de IA
# O banco guarda so o NOME da variavel (campo "variavel de ambiente da chave" do provedor no
# admin); o valor vive aqui e no ambiente de producao, nunca no banco nem no git. Trocar uma
# chave e trocar este valor e reiniciar o backend. Provedor sem a variavel definida nao e
# usado, e a sessao mostra "servico de IA indisponivel".
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_PORT_HOST=5180
VITE_API_BASE_URL=http://localhost:8010/api
VITE_WS_BASE_URL=ws://localhost:8010/ws

# ---------------------------------------------------------------------------
# Build atras de proxy com inspecao TLS (opcional)
# Deixe vazio fora da rede corporativa. Quando preenchido, deve ser o nome
# de um arquivo .crt colocado em backend/certs/.
# ---------------------------------------------------------------------------
CORPORATE_CA_CERT=
