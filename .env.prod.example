# ---------------------------------------------------------------------------
# Producao em VPS manual (docker-compose.prod.yml)
# Copie para .env no servidor (cp .env.prod.example .env), preencha e proteja o arquivo
# (chmod 600 .env). COMPOSE_FILE faz "docker compose up -d" abrir o arquivo de producao.
# Nada deste arquivo vai para o git: o .env real fica so no servidor.
# ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=convencendoai

# Dominio publico, sem https:// (ex.: app.exemplo.com.br). O registro A dele precisa apontar
# para o IP do servidor antes da primeira subida, senao o Caddy nao consegue o certificado.
DOMAIN=

# Chave longa e aleatoria, diferente da de desenvolvimento. Gere com: openssl rand -base64 48
DJANGO_SECRET_KEY=

# Banco: o servico db do compose usa estes valores na primeira subida. A senha deve ser longa e
# aleatoria; trocar depois exige trocar tambem dentro do Postgres.
POSTGRES_DB=convencendoai
POSTGRES_USER=convencendoai
POSTGRES_PASSWORD=

# Chaves dos provedores de IA. Valem so aqui, nunca no banco nem no git.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Documentacao da API e log de conversa ficam desligados em producao. Nao ligue sem necessidade.
API_DOCS_ENABLED=False
LOG_CONVERSATION_CONTENT=False
